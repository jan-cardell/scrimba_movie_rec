# Client-side (Vite) — bundled into the published site, used by config.js/index.js.
# Safe to expose: access is controlled by Supabase Row Level Security policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_API_KEY=

# Server-side only — used by netlify/functions/embed.js.
# Set this in the Netlify dashboard (Site settings > Environment variables), never with a VITE_ prefix,
# so it is never bundled into client-side code.
OPENAI_API_KEY=

# Used only when seeding embeddings locally via `node scripts/embed_movies.js`, not needed for the deployed site.
VITE_OPENAI_API_KEY=
SUPABASE_API_KEY=
